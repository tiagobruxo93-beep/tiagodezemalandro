alter table public.spiritual_site_settings enable row level security;

create policy "settings public read" on public.spiritual_site_settings
  for select using (true);

create policy "settings admin write" on public.spiritual_site_settings
  for insert to authenticated with check (public.spiritual_is_admin());

create policy "settings admin update" on public.spiritual_site_settings
  for update to authenticated using (public.spiritual_is_admin()) with check (public.spiritual_is_admin());

create table if not exists public.spiritual_ad_clicks (
  id bigserial primary key,
  ad_id uuid not null references public.spiritual_ads(id) on delete cascade,
  channel text not null default 'forward',
  created_at timestamptz not null default now()
);

create index if not exists spiritual_ad_clicks_ad_idx on public.spiritual_ad_clicks (ad_id, created_at desc);

alter table public.spiritual_ad_clicks enable row level security;

create policy "clicks public insert" on public.spiritual_ad_clicks
  for insert with check (true);

create policy "clicks admin read" on public.spiritual_ad_clicks
  for select to authenticated using (public.spiritual_is_admin());

create or replace function public.spiritual_touch_updated_at()
returns trigger
language plpgsql
set search_path = public
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

create trigger spiritual_ads_touch before update on public.spiritual_ads
  for each row execute function public.spiritual_touch_updated_at();

create trigger spiritual_settings_touch before update on public.spiritual_site_settings
  for each row execute function public.spiritual_touch_updated_at();

