create table if not exists public.spiritual_admins (
  user_id uuid primary key references auth.users(id) on delete cascade,
  email text,
  created_at timestamptz not null default now()
);

alter table public.spiritual_admins enable row level security;

create or replace function public.spiritual_is_admin()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (select 1 from public.spiritual_admins where user_id = auth.uid());
$$;

create policy "admins read own row" on public.spiritual_admins
  for select to authenticated using (user_id = auth.uid());

create or replace function public.spiritual_claim_admin()
returns boolean
language plpgsql
security definer
set search_path = public
as $$
begin
  if auth.uid() is null then
    return false;
  end if;
  if exists (select 1 from public.spiritual_admins) then
    return public.spiritual_is_admin();
  end if;
  insert into public.spiritual_admins (user_id, email)
  values (auth.uid(), (select email from auth.users where id = auth.uid()))
  on conflict (user_id) do nothing;
  return true;
end;
$$;

revoke all on function public.spiritual_claim_admin() from public, anon;
grant execute on function public.spiritual_claim_admin() to authenticated;

create table if not exists public.spiritual_ads (
  id uuid primary key default gen_random_uuid(),
  slug text not null unique,
  title text not null,
  category text not null default 'coletivo' check (category in ('coletivo', 'individual', 'consulta')),
  kicker text not null default '',
  summary text not null default '',
  description text not null default '',
  includes text[] not null default '{}',
  price_label text not null default 'Sob consulta',
  image_url text,
  forward_url text not null default '',
  forward_label text not null default 'Quero participar',
  badge text,
  active boolean not null default true,
  featured boolean not null default false,
  sort_order integer not null default 0,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create index if not exists spiritual_ads_category_idx on public.spiritual_ads (category, sort_order);

alter table public.spiritual_ads enable row level security;

create policy "ads public read" on public.spiritual_ads
  for select using (active = true or public.spiritual_is_admin());

create policy "ads admin insert" on public.spiritual_ads
  for insert to authenticated with check (public.spiritual_is_admin());

create policy "ads admin update" on public.spiritual_ads
  for update to authenticated using (public.spiritual_is_admin()) with check (public.spiritual_is_admin());

create policy "ads admin delete" on public.spiritual_ads
  for delete to authenticated using (public.spiritual_is_admin());

create table if not exists public.spiritual_site_settings (
  id integer primary key default 1 check (id = 1),
  hero_eyebrow text not null default 'Trabalhos coletivos · Umbanda',
  hero_title text not null default 'A força de muitos,',
  hero_highlight text not null default 'a firmeza do Seu Zé.',
  hero_subtitle text not null default 'Coloque seu nome na corrente de fé do terreiro. Trabalhos realizados com responsabilidade, tradição e o axé de Zé Malandro.',
  hero_image_url text not null default '/images/hero-altar.jpg',
  about_title text not null default 'Pai Tiago de Zé Malandro',
  about_text text not null default 'Sou Pai Tiago, filho de Umbanda e zelador espiritual. Há anos caminho ao lado de Seu Zé Malandro, entidade que me ensinou que a fé, a palavra e o respeito abrem qualquer porta.',
  whatsapp_number text not null default '5511999999999',
  payment_note text not null default 'Pagamento processado com segurança pela Cakto',
  footer_note text not null default 'Tradição, sigilo e axé em cada firmeza.',
  updated_at timestamptz not null default now()
