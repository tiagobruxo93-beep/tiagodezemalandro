create table if not exists public.spiritual_rate_limits (
  chave text not null,
  janela timestamptz not null,
  contagem integer not null default 0,
  primary key (chave, janela)
);

create index if not exists spiritual_rate_limits_janela_idx on public.spiritual_rate_limits (janela);

alter table public.spiritual_rate_limits enable row level security;

create or replace function public.spiritual_rate_hit(
  p_chave text,
  p_janela_segundos integer,
  p_limite integer
)
returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_janela timestamptz;
  v_contagem integer;
  v_espera integer;
begin
  if p_chave is null or length(p_chave) < 4 or p_janela_segundos < 1 or p_limite < 1 then
    return jsonb_build_object('permitido', false, 'restante', 0, 'retry_after', 60);
  end if;

  v_janela := to_timestamp(floor(extract(epoch from clock_timestamp()) / p_janela_segundos) * p_janela_segundos);

  insert into public.spiritual_rate_limits as alvo (chave, janela, contagem)
  values (left(p_chave, 160), v_janela, 1)
  on conflict (chave, janela) do update set contagem = alvo.contagem + 1
  returning contagem into v_contagem;

  if v_contagem > p_limite then
    v_espera := greatest(
      1,
      ceil(extract(epoch from ((v_janela + make_interval(secs => p_janela_segundos)) - clock_timestamp())))::integer
    );
    return jsonb_build_object('permitido', false, 'restante', 0, 'retry_after', v_espera);
  end if;

  if random() < 0.02 then
    delete from public.spiritual_rate_limits where janela < now() - interval '2 hours';
  end if;

  return jsonb_build_object(
    'permitido', true,
    'restante', greatest(0, p_limite - v_contagem),
    'retry_after', 0
  );
end;
$$;

revoke all on function public.spiritual_rate_hit(text, integer, integer) from public, anon, authenticated;
grant execute on function public.spiritual_rate_hit(text, integer, integer) to service_role;